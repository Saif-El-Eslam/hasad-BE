ENVIRONMENT=development
PORT=3000
DEV_DB_URL=mongodb://127.0.0.1:27017/hasad
PROD_DB_URL=
JWT_SECRET=
JWT_EXPIRES_IN=12h
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL=
GOOGLE_APP_PASSWORD=
# Set only when deployed behind a known proxy; leave unset for direct access.
TRUST_PROXY_HOPS=

# Internal cron and monitoring credentials (random, at least 32 characters).
CRON_SECRET=
OPERATIONS_SECRET=
# Legacy Gmail app-password alias; GOOGLE_APP_PASSWORD takes precedence.
# PASSWORD=

# Backups: use a separate random 32-byte hex key and private persistent storage.
BACKUP_DB_URL=
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=
MONGO_TOOLS_MODE=docker
MONGO_TOOLS_IMAGE=mongo:8
# Isolated restore drills only: a different DB name from the archived DB.
RESTORE_DB_URL=
RESTORE_CONFIRM_DATABASE_NAME=
